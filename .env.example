# Server
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_NAME=mcp-search

# Search engines (prefix: ENGINE_<NAME>_<KEY>)
# NAME = unique identifier, e.g. SEARXNG
ENGINE_SEARXNG_ENABLED=true
ENGINE_SEARXNG_TYPE=searxng
ENGINE_SEARXNG_BASE_URL=http://searxng:8080
#ENGINE_SEARXNG_API_KEY=secret_key_here

# Default engine used when none specified in tool call
DEFAULT_ENGINE=SEARXNG

# Content fetching
MAX_CONTENT_LENGTH=50000
REQUEST_TIMEOUT=10
SUMMARY_ENABLE=True
SUMMARY_MAX_CONTENT_LENGTH_READABILITY=512000
SUMMARY_MAX_WORDS=128

# Logging (optional)
LOG_LEVEL=INFO
